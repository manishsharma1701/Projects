        input(
            "\nDischarge at EACH final outlet "
            "(Nm3/h): "
        )
    )

    if terminal_discharge_nm3h <= 0:

        raise ValueError(
            "Discharge must be greater than zero."
        )

    # ========================================================
    # TEMPERATURE
    # ========================================================

    temperature_c = float(

        input(
            "\nGas temperature (°C): "
        )
    )

    # ========================================================
    # OUTLET PRESSURE
    # ========================================================

    outlet_pressure = float(

        input(
            "\nCommon pressure at EACH final outlet "
            "(gauge bar): "
        )
    )

    # ========================================================
    # MASS FLOW BALANCE
    # ========================================================

    node_mass_flows, source_mass_flow = (
        calculate_mass_flows(
            pipes,
            children,
            terminal_nodes,
            terminal_discharge_nm3h
        )
    )

    # ========================================================
    # COMPRESSIBLE PRESSURE SOLUTION
    # ========================================================

    pressures, iterations = solve_pressures(
        pipes,
        children,
        terminal_nodes,
        outlet_pressure,
        temperature_c
    )

    # ========================================================
    # RESULTS
    # ========================================================

    print_results(
        pipes,
        children,
        terminal_nodes,
        pressures,
        terminal_discharge_nm3h,
        source_mass_flow,
        temperature_c,
        outlet_pressure,
        iterations
    )
