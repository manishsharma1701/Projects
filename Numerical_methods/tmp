    pipes = load_network(
        filename
    )

    children = build_children(
        pipes
    )

    # --------------------------------------------------------
    # Node 8 is deliberately excluded
    # --------------------------------------------------------

    excluded_nodes = {
        "8"
    }

    terminal_nodes = find_terminal_nodes(
        pipes,
        children,
        excluded_nodes
    )

    if not terminal_nodes:

        raise ValueError(
            "No terminal nodes were found after excluding node 8."
        )

    source = find_source(
        pipes
    )

