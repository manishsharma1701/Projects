"""  Compressible Gas Pipe Network Flow and Pressure Solver  """

import math

class Pipe:

    def __init__(
        self,
        start,
        end,
        length,
        diameter=None,
        velocity=None
    ):

        self.start = start
        self.end = end
        self.length = float(length)

        # Diameter in mm
        self.diameter = (
            float(diameter)
            if diameter is not None
            else None
        )

        # Velocity in m/s
        self.velocity = (
            float(velocity)
            if velocity is not None
            else None
        )

        # Mass flow in kg/s
        self.mass_flow = 0.0

        # Actual flow in m3/h
        self.flow = 0.0

        # Normal flow in Nm3/h
        self.normal_flow = 0.0

        # Gas density in kg/m3
        self.density = 0.0

        # Calculated values
        self.reynolds = 0.0
        self.friction_factor = 0.0
        self.pressure_loss = 0.0

    def __repr__(self):

        return (
            f"{self.start} -> {self.end} "
            f"L={self.length:g} m "
            f"D={self.diameter if self.diameter is not None else 'None'} mm "
            f"V={self.velocity if self.velocity is not None else 'None'} m/s "
            f"Q={self.flow:g} m3/h "
            f"QN={self.normal_flow:g} Nm3/h"
        )

def load_network(filename):

    pipes = []

    with open(
        filename,
        "r",
        encoding="utf-8"
    ) as f:

        lines = f.readlines()

    inside_pipes = False

    for raw_line in lines:

        line = raw_line.strip()

        if line == "ALL PIPES":

            inside_pipes = True
            continue

        if not inside_pipes:
            continue

        if not line:
            continue

        if line.startswith("="):
            continue

        if line.startswith("-"):
            continue

        if line.startswith("TOTAL"):
            continue

        if line.startswith("No."):
            continue

        parts = line.split()

        if len(parts) < 7:
            continue

        try:

            start = parts[1]
            end = parts[2]

            length = float(parts[3])

            input_type = parts[4].lower()

            value = float(parts[5])

            if input_type == "diameter":

                diameter = value
                velocity = None

            elif input_type == "velocity":

                diameter = None
                velocity = value

            else:

                raise ValueError(
                    f"Unknown input type: {input_type}"
                )

            pipe = Pipe(
                start,
                end,
                length,
                diameter,
                velocity
            )

            pipes.append(pipe)

        except (ValueError, IndexError):

            continue

    if not pipes:

        raise ValueError(
            "No pipe data was found in the ALL PIPES section."
        )

    return pipes

def build_children(pipes):

    children = {}

    for pipe in pipes:

        if pipe.start not in children:
            children[pipe.start] = []

        children[pipe.start].append(pipe)

    return children

def build_parents(pipes):

    parents = {}

    for pipe in pipes:

        parents[pipe.end] = pipe

    return parents

def find_source(pipes):

    start_nodes = set()
    end_nodes = set()

    for pipe in pipes:

        start_nodes.add(pipe.start)
        end_nodes.add(pipe.end)

    source_nodes = start_nodes - end_nodes

    if len(source_nodes) == 0:

        raise ValueError(
            "Could not find source node."
        )

    if len(source_nodes) > 1:

        print(
            "Warning: More than one source was found:"
        )

        print(source_nodes)

    return list(source_nodes)[0]

def find_terminal_nodes(
    pipes,
    children,
    excluded_nodes=None
):

    if excluded_nodes is None:

        excluded_nodes = {"8"}

    terminals = []

    nodes = set()

    for pipe in pipes:

        nodes.add(pipe.start)
        nodes.add(pipe.end)

    for node in nodes:

        if node in excluded_nodes:
            continue

        if not children.get(node):

            terminals.append(node)

    return terminals

# GAS PROPERTIES
# ============================================================
R_AIR = 287.05               # J/(kg.K)
DENSITY_NORMAL = 1.204       # kg/m3 at 20 C and 1.01325 bar(a)
NORMAL_PRESSURE_BAR = 1.01325
NORMAL_TEMPERATURE_C = 20.0

def nm3h_to_mass_flow(
    flow_nm3h,
    normal_pressure_bar=NORMAL_PRESSURE_BAR,
    normal_temperature_c=NORMAL_TEMPERATURE_C
):

    temperature_k = (
        normal_temperature_c + 273.15
    )

    pressure_pa = (
        normal_pressure_bar * 100000
    )

    density = (
        pressure_pa /
        (R_AIR * temperature_k)
    )

    mass_flow = (
        flow_nm3h / 3600 * density
    )

    return mass_flow

def mass_flow_to_nm3h(
    mass_flow,
    normal_pressure_bar=NORMAL_PRESSURE_BAR,
    normal_temperature_c=NORMAL_TEMPERATURE_C
):

    temperature_k = (
        normal_temperature_c + 273.15
    )

    pressure_pa = (
        normal_pressure_bar * 100000
    )

    density = (
        pressure_pa /
        (R_AIR * temperature_k)
    )

    flow_nm3h = (
        mass_flow / density * 3600
    )

    return flow_nm3h

def mass_flow_to_actual_m3h(
    mass_flow,
    pressure_bar_g,
    temperature_c
):

    pressure_bar_a = (
        pressure_bar_g + 1.01325
    )

    pressure_pa = (
        pressure_bar_a * 100000
    )

    temperature_k = (
        temperature_c + 273.15
    )

    density = (
        pressure_pa /
        (R_AIR * temperature_k)
    )

    if density <= 0:

        return 0.0

    return (
        mass_flow / density * 3600
    )

def calculate_mass_flows(
    pipes,
    children,
    terminal_nodes,
    terminal_discharge_nm3h
):

    if terminal_discharge_nm3h <= 0:

        raise ValueError(
            "Terminal discharge must be greater than zero."
        )

    terminal_set = set(
        terminal_nodes
    )

    terminal_mass_flow = (
        nm3h_to_mass_flow(
            terminal_discharge_nm3h
        )
    )

    node_mass_flow = {}

    for node in terminal_nodes:

        node_mass_flow[node] = (
            terminal_mass_flow
        )

    def calculate_node_flow(node):

        # ----------------------------------------------------
        # Terminal outlet
        # ----------------------------------------------------

        if node in terminal_set:

            return terminal_mass_flow

        # ----------------------------------------------------
        # Excluded/dead node
        # ----------------------------------------------------

        if node == "8":

            return 0.0

        outgoing = children.get(node,[])

        if not outgoing:

            return 0.0

        total = 0.0

        for pipe in outgoing:

            child_flow = (
                calculate_node_flow(
                    pipe.end
                )
            )

            pipe.mass_flow = (
                child_flow
            )

            total += child_flow

        node_mass_flow[node] = total

        return total

    source = find_source(pipes)

    total_source_mass_flow = (
        calculate_node_flow(source)
    )

    # --------------------------------------------------------
    # Store pipe flows
    # --------------------------------------------------------

    for pipe in pipes:

        pipe.normal_flow = (
            mass_flow_to_nm3h(
                pipe.mass_flow
            )
        )

    return (
        node_mass_flow,
        total_source_mass_flow
    )

def calculate_pressure_loss(pipe,downstream_pressure_bar_g,temperature_c):
    # --------------------------------------------------------
    # Zero-flow pipe
    # --------------------------------------------------------
    if pipe.mass_flow <= 0:
        pipe.flow = 0.0
        pipe.normal_flow = 0.0
        pipe.density = 0.0
        pipe.velocity = 0.0
        pipe.reynolds = 0.0
        pipe.friction_factor = 0.0
        pipe.pressure_loss = 0.0
        return 0.0
    # --------------------------------------------------------
    # Density using downstream pressure
    # --------------------------------------------------------
    temperature_k = temperature_c + 273.15       # °C -> K

    pressure_bar_a = (downstream_pressure_bar_g + 1.01325) # gauge -> absolute

    pressure_pa = (pressure_bar_a * 100000)  # bar -> Pa

    density = (pressure_pa / (R_AIR * temperature_k))   # rho = P/(RT)

    # --------------------------------------------------------
    # Actual volumetric flow
    # --------------------------------------------------------

    actual_flow_m3s = (pipe.mass_flow / density)   # Q = m_dot/rho

    # --------------------------------------------------------
    # Diameter / Velocity
    # --------------------------------------------------------

    if pipe.diameter is not None:

        diameter = pipe.diameter / 1000          # mm -> m

        area = (
            math.pi *
            diameter**2 / 4
        )                                         # A = pi*D^2/4

        velocity = (
            actual_flow_m3s / area
        )                                         # V = Q/A

    elif pipe.velocity is not None:

        velocity = pipe.velocity                 # Given velocity

        area = (
            actual_flow_m3s / velocity
        )                                         # A = Q/V

        diameter = math.sqrt(
            4 * area / math.pi
        )                                         # D = sqrt(4A/pi)

        pipe.diameter = (
            diameter * 1000
        )                                         # m -> mm

    else:

        raise ValueError(
            f"Pipe {pipe.start} -> {pipe.end} "
            f"has no diameter or velocity."
        )

    # --------------------------------------------------------
    # Store flow properties
    # --------------------------------------------------------

    pipe.flow = (
        actual_flow_m3s * 3600
    )                                             # m3/s -> m3/h

    pipe.velocity = velocity
    pipe.density = density

    # --------------------------------------------------------
    # Reynolds Number
    # --------------------------------------------------------

    viscosity = 1.81e-5                         # Pa.s

    reynolds = (
        density *
        abs(velocity) *
        diameter /
        viscosity
    )                                             # Re = rho*V*D/mu

    pipe.reynolds = reynolds

    # --------------------------------------------------------
    # Friction Factor
    # --------------------------------------------------------

    roughness = 0.000045                         # m

    relative_roughness = (
        roughness / diameter
    )                                             # epsilon/D

    if reynolds <= 0:

        friction_factor = 0.0

    elif reynolds < 2300:

        friction_factor = (
            64 / reynolds
        )                                         # Laminar: f=64/Re

    else:

        friction_factor = (
            0.25 /
            math.log10(
                relative_roughness / 3.7 +
                5.74 / reynolds**0.9
            )**2
        )                                         # Swamee-Jain

    pipe.friction_factor = friction_factor

    # --------------------------------------------------------
    # Darcy-Weisbach Pressure Loss
    # --------------------------------------------------------

    pressure_loss_pa = (
        friction_factor *
        (pipe.length / diameter) *
        density *
        velocity**2 / 2
    )                                             # ΔP=f(L/D)(rho*V²/2)

    pressure_loss_bar = (pressure_loss_pa / 100000)  # Pa -> bar

    pipe.pressure_loss = pressure_loss_bar

    return pressure_loss_bar

def calculate_node_pressures(
    pipes,
    children,
    terminal_nodes,
    outlet_pressure,
    temperature_c
):

    pressures = {}

    for node in terminal_nodes:

        pressures[node] = (
            outlet_pressure
        )

    terminal_set = set(
        terminal_nodes
    )

    def calculate_pressure(node):

        # ----------------------------------------------------
        # Terminal outlet
        # ----------------------------------------------------

        if node in terminal_set:

            return pressures[node]

        # ----------------------------------------------------
        # Node 8 is excluded/dead
        # ----------------------------------------------------

        if node == "8":
            pressures[node] = (outlet_pressure)
            return pressures[node]

        outgoing = children.get(node,[])

        if not outgoing:
            pressures[node] = (outlet_pressure)
            return pressures[node]

        upstream_pressures = []

        for pipe in outgoing:

            # ------------------------------------------------
            # Dead pipe
            # ------------------------------------------------

            if pipe.mass_flow <= 0:

                continue

            child_pressure = (
                calculate_pressure(
                    pipe.end
                )
            )

            pressure_loss = (
                calculate_pressure_loss(
                    pipe,
                    child_pressure,
                    temperature_c
                )
            )

            upstream_pressure = (
                child_pressure +
                pressure_loss
            )

            upstream_pressures.append(
                upstream_pressure
            )

        if not upstream_pressures:

            pressures[node] = (
                outlet_pressure
            )

            return pressures[node]

        # ----------------------------------------------------
        # Required pressure is maximum branch pressure
        # ----------------------------------------------------

        pressures[node] = max(
            upstream_pressures
        )

        return pressures[node]

    source = find_source(pipes)

    calculate_pressure(source)

    return pressures

def solve_pressures(
    pipes,
    children,
    terminal_nodes,
    outlet_pressure,
    temperature_c,
    tolerance=1e-6,
    max_iterations=100
):

    pressures = {}

    # Initial pressure estimate
    for node in terminal_nodes:

        pressures[node] = (
            outlet_pressure
        )

    source = find_source(pipes)

    old_source_pressure = None

    for iteration in range(
        max_iterations
    ):

        pressures = calculate_node_pressures(
            pipes,
            children,
            terminal_nodes,
            outlet_pressure,
            temperature_c
        )

        source_pressure = pressures.get(
            source,
            outlet_pressure
        )

        if old_source_pressure is not None:

            difference = abs(
                source_pressure -
                old_source_pressure
            )

            if difference < tolerance:

                break

        old_source_pressure = (
            source_pressure
        )

    return pressures, iteration + 1

def get_nodes(pipes):

    nodes = []

    for pipe in pipes:

        if pipe.start not in nodes:

            nodes.append(
                pipe.start
            )

        if pipe.end not in nodes:

            nodes.append(
                pipe.end
            )

    return nodes

